# BESTIET FRESH: Shared Hosting Apache Configuration (.htaccess)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTPS (optional for shared hosting)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route HTML pages
  RewriteRule ^login/?$ login.html [L]
  RewriteRule ^admin/dashboard/?$ admin/dashboard.html [L]
  RewriteRule ^admin/inventory/?$ admin/inventory.html [L]
  RewriteRule ^admin/products/?$ admin/products.html [L]
  RewriteRule ^admin/orders/?$ admin/orders.html [L]
  RewriteRule ^admin/customers/?$ admin/customers.html [L]
  RewriteRule ^admin/reports/?$ admin/reports.html [L]
  RewriteRule ^admin/settings/?$ admin/settings.html [L]
  RewriteRule ^admin/simulator/?$ admin/simulator.html [L]

  # Fallback for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

# Caching & Compression Optimization
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/xml
</IfModule>
